# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this to Railway environment variables
# =============================================================================

# --- REQUIRED API KEYS ---
GITHUB_AUTH_TOKEN=ghp_your_token_here
OPENAI_API_KEY=sk-your_key_here
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# --- DATABASE (Railway Volume) ---
DATABASE_PATH=/data/data_storage.db
FAISS_DIR=/data/faiss_indexes

# --- CORS (Production Domains) ---
ALLOWED_ORIGINS=https://visdep.com,https://www.visdep.com,https://visdep.vercel.app

# --- OPTIONAL (for debugging) ---
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
